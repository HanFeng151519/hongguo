{
  "name": "hongguo-crawl-ios",
  "version": "1.0.0",
  "private": true,
  "description": "视频爬取 iOS App（Capacitor，内置爬虫逻辑，无需 Python 后端）",
  "scripts": {
    "build:web": "node scripts/copy-web.js",
    "ensure:sr-model": "bash scripts/ensure-sr-model.sh",
    "cap:sync": "npm run build:web && npx cap sync ios && node scripts/patch-ios-plugins.js",
    "cap:ios": "npx cap open ios",
    "cap:run:ios": "npx cap run ios",
    "install:device": "bash scripts/install-ios-device.sh"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/clipboard": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.7.2"
  }
}
