# 一键剪辑 LLM（默认 LM Studio + gemma-4-e4b-it，OpenAI 兼容）
# 先在本机 LM Studio 加载模型并开启 Local Server（默认 http://127.0.0.1:1234）
QWEN_API_BASE=http://127.0.0.1:1234/v1
QWEN_MODEL=gemma-4-e4b-it
QWEN_CODE_MODEL=gemma-4-e4b-it
QWEN_API_KEY=lm-studio
QWEN_TEMPERATURE=0
# LM Studio 本地模型一般不支持 json_object，勿开（默认已自动跳过）
# HONGGUO_LLM_JSON_MODE=0

# 若改回阿里云 DashScope，可改为：
# QWEN_API_KEY=sk-...
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# 红果 / 站外 / 达人中心（见 README）
# HONGGUO_API_BASE=
# 推广中心 book-detail 页 invite_user_share_token（Playwright 与 Referer 必需）
# HONGGUO_FQ_KOC_INVITE_TOKEN=LH1jwGOWSWOrFXIB4-gnuJN02QvPPRX0qax3sjOl7ug=
# book-detail 页 genre（换剧须改；与地址栏一致，如 203 / 205）
# HONGGUO_FQ_KOC_GENRE=203
# 按剧单独配置：HONGGUO_FQ_KOC_GENRE_7637911894363212825=203
# 仅部分链接需要 key 时再填，勿默认 205_0
# HONGGUO_FQ_KOC_DETAIL_KEY=205_0
# HONGGUO_FQ_KOC_COOKIE=
# HONGGUO_FQ_KOC_MS_TOKEN=
# HONGGUO_FQ_KOC_A_BOGUS=
# HONGGUO_FQ_KOC_CREATE_URL=https://koc.fqopenplatform.com/api/platform/content/batch_download/create/v1?app_id=457699&aid=457699
# F12 → batch_download/create → Request Payload（必填，否则接口 200 空响应）
# HONGGUO_FQ_KOC_DOWNLOAD_BODY={"book_id":"{book_id}","item_id_list":["{item_id}"],"tab_type":6,"content_tab_type":6}
# 生成页「导入 F12 抓包」会保存到 public/materials/fq_koc/koc_session.json 并自动刷新 msToken
# HONGGUO_FQ_KOC_AUTO_PERSIST=1
# 浏览器自动同步（默认关闭；需另装 server/requirements-browser.txt）
# HONGGUO_FQ_KOC_AUTO_SYNC=0
# Playwright 首次启动后保持 Chrome 不关（默认 1，利于多集下载不断登）
# HONGGUO_FQ_KOC_BROWSER_KEEP_ALIVE=1
# 默认勿把 .env Cookie 注入浏览器（=0），否则易覆盖刚登录会话导致「一上来就掉线」
# HONGGUO_FQ_KOC_INJECT_ENV_COOKIE=0
# 抖音自建爬虫（主页「抖音分享爬取」）：F12 → Network → douyin.com 请求 → 复制 Cookie
# HONGGUO_DOUYIN_COOKIE=
# 默认 1=仅自建爬虫（httpx+接口/页面）；0=失败时再回退 yt-dlp
# HONGGUO_DOUYIN_CRAWL_ONLY=1
# 抖音爬取优先无水印 play 直链（0=允许回退 playwm 含水印）
# HONGGUO_DOUYIN_NO_WATERMARK=1
# 或读取浏览器 Cookie（Windows 下 chrome 开着会失败，优先用上一行 HONGGUO_DOUYIN_COOKIE）
# HONGGUO_YTDLP_COOKIES_FROM_BROWSER=edge
# chrome 失败时自动再试 edge（默认 win32 已开启；可设 HONGGUO_YTDLP_COOKIES_FALLBACK= 关闭）
# HONGGUO_YTDLP_COOKIES_FALLBACK=edge
# Netscape cookies.txt 文件路径（可选）
# HONGGUO_DOUYIN_COOKIE_FILE=
# 登录页是否走 invite 邀请链（默认：已配 INVITE_TOKEN 则用，页面上显示机构名）
# 若登录后易掉线可设 HONGGUO_FQ_KOC_LOGIN_USE_INVITE=0 改回稳定会员页
# HONGGUO_FQ_KOC_LOGIN_USE_INVITE=1
# 原味模式（默认开）：正片原声原速、不叠 meme/解说条；轻度像素去重过抖音判重
HONGGUO_AUTHENTIC=1
# 抖音投流合规（随 AUTHENTIC 默认开）：片头/文案禁「红果搜/第三方 App」；片尾默认关
# HONGGUO_DOUYIN_SAFE=1
# HONGGUO_COMPLIANCE_BRAND=丰丰漫剧
# HONGGUO_SPLASH_SUBTITLE=——  高能短剧 · 关注看全集  ——
# 封面（《关键词》）文案全部可配置
# HONGGUO_SPLASH_TITLE_FALLBACK=短剧
# HONGGUO_SPLASH_TITLE_LBRACKET=《
# HONGGUO_SPLASH_TITLE_RBRACKET=》
# 副标题默认值（不填则用代码内置）
# HONGGUO_SPLASH_SUBTITLE_SAFE_DEFAULT=——  高能短剧 · 关注看全集  ——
# HONGGUO_SPLASH_SUBTITLE_PROMO_DEFAULT=——  红果短剧搜索看全集  ——
# 专业 30s：黄金口播 + 23s 冲突高光 + 片尾 CTA
# 成片画幅：auto/native=源片多大输出多大（720×1280 即 720×1280）；standard=平台标准 1080×1920/1920×1080
# HONGGUO_OUTPUT_ASPECT=auto
# 去水印成片（主页「去掉视频水印」；也可在页面上选 4K/120 帧，优先于下列全局项）
# HONGGUO_WM_OUTPUT_WIDTH=2160
# HONGGUO_WM_OUTPUT_HEIGHT=3840
# HONGGUO_WM_OUTPUT_FPS=120
# HONGGUO_OUTPUT_FPS=60
# AI 超分（Real-ESRGAN ncnn-vulkan；主页也可选「AI 超分」）
# HONGGUO_WM_ENHANCE=sr
# HONGGUO_REALESRGAN_BIN=
# HONGGUO_REALESRGAN_MODEL=realesrgan-x4plus
# 真人视频推荐 realesrgan-x4plus；动漫可用 realesr-animevideov3
# HONGGUO_REALESRGAN_TILE=128
# AI 超分耗时很长，默认关闭 uvicorn --reload；仅开发调试时设 1
# HONGGUO_UVICORN_RELOAD=0
# HONGGUO_HOOK_TEMPLATE=pro_60
# HONGGUO_FIXED_OPENING_TEXT=30秒速览精品好剧！
# HONGGUO_FIXED_OUTRO_TEXT=关注我，带您看更多好剧！
# 片头口播开关（默认开；设 0 则直接从正片开始）
# HONGGUO_OPENING_VOICEOVER=1
# 片尾口播开关（默认关；设 1 才追加「剧名在评论区」等尾帧 TTS）
# HONGGUO_OUTRO_VOICEOVER=0
# 片头关键词封面卡（默认关：不再加第一页封面）
# HONGGUO_OPENING_SPLASH=0
# 口播字幕（默认关：仅保留配音，不叠字幕）
# HONGGUO_VOICEOVER_SUBTITLE=0
# 片尾高光闪帧（默认开：12 帧 / 3 秒 + 口播）
# HONGGUO_OUTRO_FLASH=1
# HONGGUO_OUTRO_FLASH_FRAMES=12
# HONGGUO_OUTRO_FLASH_SEC=3
# HONGGUO_BODY_OUTRO_FADE=1
# HONGGUO_FREEZE_CAPTION=
# HONGGUO_HOOK_PRESET=30s
# HONGGUO_HOOK_TARGET_SEC=30
# HONGGUO_GOLDEN_OPEN_SEC=4
# HONGGUO_BODY_MAIN_SEC=30
# AI 剪辑脚本：后段高光建议 20s（配合前10秒原片保留）
# HONGGUO_AI_BODY_SCRIPT_MAX_SEC=20
# HONGGUO_AI_BODY_SCRIPT_OPT_LO=18
# HONGGUO_AI_BODY_SCRIPT_OPT_HI=20
# 固定首段结构：前10秒保留原片，后20秒交给AI/程序
# HONGGUO_KEEP_HEAD_SEC=10
# HONGGUO_AI_TAIL_SEC=20
# 前10秒从正片内容起算（优先避开 logo/过渡，按首句对白附近起切）
# HONGGUO_KEEP_HEAD_FROM_CONTENT=1
# 故事完整优先：时长由 AI 据对白决定，但仍受上述上限约束
# HONGGUO_STORY_FIRST_EDIT=1
# 两段高光直剪（默认开，不调用 LLM）：每集取音画 score 最高的 2 段
# HONGGUO_SIMPLE_HIGHLIGHT_EDIT=1
# HONGGUO_SIMPLE_HIGHLIGHT_CLIPS=2
# 两段高光在源片上的最小间隔（秒），过近易重复且易触发限流；不合并，只错开
# HONGGUO_SIMPLE_HIGHLIGHT_MIN_GAP_SEC=18
# 成片时间轴上两段之间的最小间隔（秒），禁止合并为一段
# HONGGUO_SIMPLE_HIGHLIGHT_CLIP_SEP_SEC=2.5
# 全钩子剪辑法（默认开）：只保留诱惑/擦边/悬念/反转/眼神/冲突/高光，不追求剧情完整
# HONGGUO_AI_HOOK_ONLY=1
# 模型输出本地硬裁：最多段数 / 单段时长（不信模型原值）
# HONGGUO_HOOK_PLAN_MAX_CLIPS=7
# HONGGUO_HOOK_CLIP_MIN_SEC=2.5
# HONGGUO_HOOK_CLIP_MAX_SEC=5.5
# 保留主视频第一句台词（默认开）：首段首刀锚定到第一句对白
# HONGGUO_KEEP_FIRST_LINE=1
# 强制保留台词（按包含匹配，支持 | , ; 分隔）
# HONGGUO_FORCE_KEEP_LINES=轻点|我快喘不过气了|你个登徒子|好细的腰
# HONGGUO_FREEZE_SEC=0
# 0 或 HONGGUO_BODY_OUTRO_SKIP=1：正片结束直接接片尾口播，不插黑场（仍默认最后一镜淡出 1s）
# HONGGUO_BODY_OUTRO_SKIP=1
# 直切片尾口播时最后一镜淡出秒数（默认 1.0；设 0 关闭）
# HONGGUO_BODY_TAIL_FADE_SEC=1.0
# 片尾过渡：0=黑场字幕不重复末镜（默认）；>0 才复用正片末端实拍秒数
# HONGGUO_OUTRO_TAIL_VIDEO_SEC=0
# 叙事节奏：压霸气段、反转前补 B 过渡（默认开）
# HONGGUO_ARC_PACING_POLISH=1
# HONGGUO_ARC_POWER_MAX_SEC=16
# HONGGUO_ARC_BRIDGE_GAP_SEC=18
# 略偏前段爽点，后段仍留铺垫（非删光后段）
# HONGGUO_HOOK_FRONT_HEAVY=1
# HONGGUO_EARLY_BODY_RATIO=0.68
# HONGGUO_LATE_START_RATIO=0.58
# HONGGUO_MIN_LATE_BODY_SEC=10
# HONGGUO_MAX_LATE_BODY_SEC=18
# HONGGUO_DIALOGUE_COMPLETE=1
# 生成前抽取对白时间轴（内嵌字幕优先，否则 faster-whisper ASR）
# HONGGUO_ASR_ENABLED=1
# HONGGUO_ASR_MODEL=small
# pip install -r server/requirements-asr.txt（start.sh 在 ASR 开启时会自动安装）
# 国内首次下载模型易超时，默认走镜像（关：HONGGUO_HF_MIRROR=0）
# HONGGUO_HF_ENDPOINT=https://hf-mirror.com
# 本地已下载的模型目录：HONGGUO_ASR_MODEL_PATH=/path/to/small
# 向 AI 发送完整对白表（默认开）；超长时截断上限字符数
# HONGGUO_TRANSCRIPT_FULL=1
# HONGGUO_TRANSCRIPT_MAX_CHARS=120000
# 无对白表时仍调 LLM 会在 hook_summary 标警告
# HONGGUO_AI_REQUIRE_TRANSCRIPT=1
# 画面/音效高能轴（音浪+镜头切分，默认开，与对白表一起给 AI）
# HONGGUO_VISUAL_PROFILE=1
# 视觉模型（gemma-4 / *-vl）：抽关键帧 JPEG 传入多模态 API（默认开）
# 纯文本剪辑推荐关：HONGGUO_VISION_FRAMES=0（无对白由程序画面轴选段）
# 纯文本 qwen3.5-9b 等不会自动走多模态；确认支持看图时再设 HONGGUO_VISION_FORCE=1
# HONGGUO_VISION_FRAMES=0
# HONGGUO_SILENT_GAP_MIN_SEC=3.5
# HONGGUO_VISION_FRAMES=1
# HONGGUO_VISION_MAX_FRAMES=16
# 仅当 LM 多模态 400/太慢时再单独压低发送张数（不设则与上一项同为 16）
# HONGGUO_VISION_LM_MAX_FRAMES=12
# HONGGUO_VISION_FRONT_RATIO=0.6
# 分层采样配额（前/中/后），默认 7/4/5
# HONGGUO_VISION_QUOTA=7/4/5
# HONGGUO_VISION_FRAME_WIDTH=512
# 小上下文模型（如 4k）自动压缩提示词，避免 n_keep 超限
# HONGGUO_LLM_COMPACT_PROMPT=1
# HONGGUO_LLM_PROMPT_MAX_CHARS=2200
# AI 分镜校验失败自动重答一次；相邻 clip 间隔上限（秒）
# HONGGUO_AI_EDIT_RETRY=1
# 源片相邻 clip 起点间隔上限（连贯模式默认 35，否则 30；你这类 26s 跳剪通常合法）
# HONGGUO_MAX_CLIP_GAP_SEC=35
# HONGGUO_CLIP_DURATION_TOL=0.5
# 钩子前重后轻：后段(≥52%片长)最多 10s，前段介绍/爽点占 ~82%
# HONGGUO_HOOK_FRONT_HEAVY=1
# HONGGUO_LATE_START_RATIO=0.52
# HONGGUO_MAX_LATE_BODY_SEC=10
# HONGGUO_EARLY_BODY_RATIO=0.82
# 台词说完整优先（默认开）；片头口播时原声 duck 至约 14%
# HONGGUO_DIALOGUE_COMPLETE=1
# 正片对白压缩（默认关，只出一版、按 AI 分镜全长）
# HONGGUO_DIALOGUE_COMPRESS=0
# HONGGUO_HOOK_DUAL_DIALOGUE_EXPORT=0
# HONGGUO_DIALOGUE_COMPRESS_GRACE=10
# 首段入点超过该秒数则自动锚定到「开场视听+前段高能」（对齐优选成片前段）
# HONGGUO_OPENING_ANCHOR_MAX_SEC=18
# HONGGUO_OPENING_CLIP_MIN_SEC=10
# 大间隔跳剪：默认自动补「跳剪」不触发 LLM 重答；=1 才严格校验
# HONGGUO_CLIP_GAP_STRICT=0
# HONGGUO_DIALOGUE_TAIL_PAD=0.45
# HONGGUO_GOLDEN_DUCK_ORIGINAL=0.14
# 完整度模式下整条钩子约 54~72s，不强行卡 60
# 正片 reason 对齐后目标区间（秒）：只拉到 end_sec，总长超上限则收短
# HONGGUO_BODY_SPAN_MIN=55
# HONGGUO_BODY_SPAN_MAX=70
# 严格按 AI 分镜入点/时长（默认开）；末帧定格凑时长默认关（会造成长停顿）
# HONGGUO_AI_CLIP_STRICT=1
# 正片严格按 AI 分镜（不压 50s 配方）；仅片头+片尾固定
# HONGGUO_AI_BODY_FAITHFUL=1
# AI 自主剪辑：每集按高光+简版叙事+故事完整自主选点（默认开，勿套单集模板）
# HONGGUO_AI_EDITOR_AUTONOMY=1
# 规则强约束叙事（仅当 AI_EDITOR_AUTONOMY=0 时生效）：短开篇、限后段碎跳
# HONGGUO_NARRATIVE_COHESION=0
# HONGGUO_OPENING_FIRST_MAX_SEC=8
# HONGGUO_MAX_COHESIVE_CLIPS=4
# HONGGUO_GOLDEN_OPEN_SEC=3.5
# HONGGUO_BODY_PAD_ENABLED=0
# 连贯少切（默认）：5 段×约 9s；密集：HONGGUO_CLIP_STYLE=dense
# HONGGUO_CLIP_STYLE=cohesive
# HONGGUO_CLIP_MIN_SEC=6
# HONGGUO_CLIP_MAX_SEC=12
# HONGGUO_CLIPS_PER_EPISODE=5
# HONGGUO_BODY_MAIN_SEC=50
# 题材轻提示（留空=按剧名简介自动识别；未识别则用全品类通用规则）
# shuangwen | sweet | suspense | urban | revenge | family | general
# HONGGUO_DRAMA_TYPE=
# HONGGUO_OUTRO_CTA_SEC=3
# HONGGUO_OPENING_CARD_SEC=4.5
# HONGGUO_OPENING_TTS_PAD_SEC=0.35
# 需要站内话术片尾（非站外搜索）：HONGGUO_ORIGINALITY_OUTRO=1
HONGGUO_ORIGINALITY_LIGHT=1
# 正片倍速：原味模式强制 1x（加速≈62%更快且音调变尖）；非原味默认 1.618
HONGGUO_BODY_PLAYBACK_SPEED=1
# 原味下仍要加速（不推荐）：HONGGUO_AUTHENTIC_ALLOW_SPEED=1
# 关闭原味后若要 meme/正片 TTS：HONGGUO_MEME_ON_BODY=1  HONGGUO_TTS_ON_BODY=1
# HONGGUO_MEME_ON_BODY=0
# HONGGUO_TTS_ON_BODY=0
# HONGGUO_BODY_BURN_SUBTITLES=0
# 多集钩子成片时长区间（秒，默认 150–210 ≈ 2分30–3分30，优先保完整）
HONGGUO_HOOK_MIN_SEC=150
HONGGUO_HOOK_MAX_SEC=210
# 偏好中点（可选，落在 min–max 之间）
HONGGUO_HOOK_TARGET_SEC=180
# HONGGUO_HOOK_BUDGET=1
# 每集多片段快切（默认 4 段/集，每段约 5-12s，非连续 30s）
# HONGGUO_MULTI_CLIP=1
# HONGGUO_CLIPS_PER_EPISODE=4
# HONGGUO_CLIP_MIN_SEC=7
# HONGGUO_CLIP_MAX_SEC=13
# 每段多留尾音，避免台词被硬切（秒）
# HONGGUO_CLIP_TAIL_PAD_SEC=0.9
# 段与段交叉淡化（秒）
# HONGGUO_CLIP_CROSSFADE_SEC=0.28
# 源片上相邻片段起点最小间隔（秒）
# HONGGUO_CLIP_MIN_GAP_SEC=3
# 片头「网络视听」备案画面：自动检测片头切镜并跳过（默认开）
# HONGGUO_COMPLIANCE_INTRO_STRIP=1
# HONGGUO_COMPLIANCE_INTRO_MAX_SEC=8
# HONGGUO_COMPLIANCE_INTRO_MIN_CUT_SEC=2.0
# HONGGUO_COMPLIANCE_INTRO_MAX_CUT_SEC=5.0
# HONGGUO_COMPLIANCE_INTRO_PAD_SEC=0.15
# 固定跳过秒数（设了则不再自动检测）：HONGGUO_COMPLIANCE_INTRO_FIXED_SEC=4.5
# 角落水印（默认关；需要时设 HONGGUO_WATERMARK=1 并可改文案）
# HONGGUO_WATERMARK=0
# HONGGUO_WATERMARK_TEXT=丰丰漫剧推荐
# 剪辑后端：moviepy（默认，便于后期解说/TTS）| ffmpeg
# HONGGUO_VIDEO_BACKEND=moviepy
# Meme 风 AI 剪辑（梗字幕 + 卡点缩放，默认开启）
# HONGGUO_MEME_EDIT=1
# Edge TTS 解说（默认开启）：xiaoyi 活泼 | xiaoxiao | yunyang | random | rotate
# HONGGUO_TTS=1
# HONGGUO_TTS_VOICE=xiaoyi
# HONGGUO_TTS_RATE=+2%
# HONGGUO_TTS_PITCH=+0Hz
# 原声：非解说时段音量（默认 1.06 略增强）；解说时段 duck 到 0.58
# HONGGUO_TTS_ORIGINAL_VOLUME=1.06
# HONGGUO_TTS_DUCK_ORIGINAL=0.58
# HONGGUO_TTS_NARR_VOLUME=0.92
# 片头/片尾口播卡、黄金口播 TTS 响度（默认 1.18，仍嫌小声可调到 1.25~1.35）
# HONGGUO_CARD_TTS_VOLUME=1.18
# 正片首段原声上限 + 淡入（默认 0.94，减轻口播后原声突然变大）
# HONGGUO_BODY_ENTRY_VOLUME=0.94
# HONGGUO_TTS_SMART_DUCK=1
# 抖音去重增强（默认开启）：解说字幕、微缩放调色、解说过渡卡、片尾搜索引导
# HONGGUO_ORIGINALITY=1
# HONGGUO_ORIGINALITY_OUTRO=1
# 片头标题卡字号（px）；生成页可实时调，此处为默认兜底
# HONGGUO_SPLASH_TITLE_FONT=120
# HONGGUO_SPLASH_SUBTITLE_FONT=70
# —— 生成耗时优化（不改叙事质量时优先）——
# 多段正片并行 MoviePy 编码（默认 2；内存紧可设 1）
# HONGGUO_ENCODE_PARALLEL=2
# 成片生成时防熄屏：每 3 分钟微移鼠标 1 像素（macOS 需终端辅助功能权限）
# HONGGUO_KEEP_AWAKE=1
# HONGGUO_KEEP_AWAKE_INTERVAL_SEC=180
# HONGGUO_KEEP_AWAKE_NUDGE_PX=1
# HONGGUO_BODY_ENCODE_PRESET=veryfast
# HONGGUO_FFMPEG_THREADS=4
# 二次生成同一集：对白/画面轴会读素材旁 .xxx_transcript.json 缓存
# LLM 校验失败重答（关可省一轮本地推理）：HONGGUO_AI_EDIT_RETRY=0
# 非真·视觉模型勿开 HONGGUO_VISION_FORCE（会抽 16 帧+大图推理）
# CDN 下载块大小 MB（默认 2，网络好可设 4）
# HONGGUO_DOWNLOAD_CHUNK_MB=2
# F12 下载 MP4 时 URL 中 ? 后的参数（ft/dy_q/l 过期时整段替换）
# HONGGUO_FQ_KOC_VOD_QUERY=a=457699&ch=0&...&ft=...&dy_q=...&l=...
# 整段 MP4 直链（跳过 batch_download；换剧须同时改 URL + 下方 book/item 绑定，否则会忽略直链）
# HONGGUO_FQ_KOC_DIRECT_MP4_URL=https://v6-fqkol.fanqieopenvod.com/.../video.mp4?a=457699&...
# HONGGUO_FQ_KOC_DIRECT_ITEM_ID=7615470191303986238
# HONGGUO_FQ_KOC_DIRECT_BOOK_ID=7615465407347952664
# 多剧共用「第N集.mp4」文件名时勿开；仅单剧本地素材时可设 1
# HONGGUO_ALLOW_SHARED_TITLE_FILES=0
# 按 item_id 单独配置：HONGGUO_FQ_KOC_MP4_URL_{item_id}=https://...
